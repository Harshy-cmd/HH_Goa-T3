# =============================================================================
# Face ID + Blockchain Verification -- configuration
#
#   cp .env.example .env      then fill in the values below.
#
# .env is gitignored. Never commit real keys. The private key below should be a
# THROWAWAY testnet wallet that has never held mainnet funds.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REVERSE IMAGE SEARCH  (required)
# -----------------------------------------------------------------------------
# Which provider to use: "serpapi" (default) or "google_vision".
SEARCH_PROVIDER=serpapi

# --- serpapi -----------------------------------------------------------------
# Google Lens via SerpAPI. Free tier: 100 searches/month.
# Get a key: https://serpapi.com/users/sign_up  ->  https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- google_vision (fallback provider) ---------------------------------------
# Google Cloud Vision WEB_DETECTION. Free tier: 1000 units/month.
# Enable the Vision API on a GCP project, then create an API key:
#   https://console.cloud.google.com/apis/library/vision.googleapis.com
#   https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=

# -----------------------------------------------------------------------------
# 2. BLOCKCHAIN  (required)
# -----------------------------------------------------------------------------
# Ethereum-compatible JSON-RPC endpoint. The default below is a public Sepolia
# endpoint and needs no API key. Any EVM RPC works (Anvil: http://127.0.0.1:8545).
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the account that submits the registration transaction.
# Sepolia faucets (need ~0.005 ETH, far less than a faucet drip):
#   https://cloud.google.com/application/web3/faucet/ethereum/sepolia
#   https://www.alchemy.com/faucets/ethereum-sepolia
# With or without the 0x prefix. THROWAWAY TESTNET KEY ONLY.
PRIVATE_KEY=

# Address of an already-deployed VerificationRegistry. Leave blank the first
# time; `python -m app deploy` prints the address to paste here.
CONTRACT_ADDRESS=

# -----------------------------------------------------------------------------
# 3. FACE MATCHING  (optional -- defaults are the OpenCV-published values)
# -----------------------------------------------------------------------------
# SFace cosine similarity. HIGHER = more similar. OpenCV's published
# same-identity threshold for this model is 0.363. See README > Face Matching.
FACE_MATCH_THRESHOLD=0.363

# Similarity at or above this but below FACE_MATCH_THRESHOLD is reported as
# POSSIBLE MATCH rather than NO MATCH. This band is our own conservative
# convention, not a published value.
FACE_REVIEW_THRESHOLD=0.300

# Minimum YuNet detection confidence for a face to be considered.
FACE_DETECT_CONFIDENCE=0.850
