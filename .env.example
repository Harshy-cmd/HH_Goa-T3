# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy this file to .env and fill in your real values.
#                  NEVER commit your actual .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Cloud Vision API ───────────────────────────────────────────────────
# Path to your service-account JSON key (preferred) OR a plain API key string.
# If using a service-account file, set GOOGLE_APPLICATION_CREDENTIALS instead:
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# ── Blockchain / Web3 ─────────────────────────────────────────────────────────
# RPC endpoint for the testnet you are targeting.
# Polygon Amoy (recommended for this project):
#   https://rpc-amoy.polygon.technology/
#   or via Alchemy/Infura: https://polygon-amoy.g.alchemy.com/v2/<YOUR_KEY>
# Ethereum Sepolia (alternative):
#   https://rpc.sepolia.org  or  https://sepolia.infura.io/v3/<YOUR_KEY>
WEB3_RPC_URL=https://rpc-amoy.polygon.technology/

# Private key of the wallet that will sign & pay for transactions.
# Export from MetaMask → Account Details → Export Private Key.
# Must be funded with testnet MATIC (Amoy) or testnet ETH (Sepolia).
# Include the leading 0x.
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Corresponding public address (used for nonce lookups & logging only).
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# ── Optional overrides ────────────────────────────────────────────────────────
# Chain ID — 80002 for Polygon Amoy, 11155111 for Sepolia
CHAIN_ID=80002

# Gas limit for data-only transactions (default 100000 is usually fine)
GAS_LIMIT=100000
