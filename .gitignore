# --- secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- generated artifacts -----------------------------------------------------
# Run outputs are reproducible; they are not source. Kept out of git so the
# repo can never be mistaken for shipping a pre-baked "successful" result.
artifacts/*
!artifacts/.gitkeep

# --- downloaded model weights (~39 MB, fetched on first run) -----------------
models/*
!models/.gitkeep

# --- sample input images -----------------------------------------------------
# Face images are biometric data and are not committed. scripts/fetch_sample.py
# downloads a CC-licensed portrait on demand; see samples/ATTRIBUTION.md.
samples/*
!samples/.gitkeep
!samples/ATTRIBUTION.md

# --- solc / foundry caches ---------------------------------------------------
# Only the repo-root build/ is a throwaway solc cache. contracts/build/ holds the
# committed, precompiled contract artifact and IS tracked (anchored path below).
.solcx/
/build/
tools/

# --- editor / os -------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
